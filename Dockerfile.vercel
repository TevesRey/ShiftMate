    FROM dunglas/frankenphp:1-php8.4-bookworm

RUN install-php-extensions \
    pdo_mysql \
    pdo_pgsql \
    mbstring \
    dom \
    xml \
    xmlwriter \
    curl \
    intl \
    zip \
    gd \
    opcache

# Remove file capabilities that restricted container hosts may reject.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && (setcap -r /usr/local/bin/frankenphp || true) \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY . .
COPY Caddyfile /etc/frankenphp/Caddyfile

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --no-progress \
    --optimize-autoloader

# Ignore any locally generated connection config in the image.
RUN rm -f bootstrap/cache/config.php

RUN mkdir -p bootstrap/cache \
    && mkdir -p /tmp/shiftmate-storage/app/private \
    /tmp/shiftmate-storage/app/public \
    /tmp/shiftmate-storage/framework/cache/data \
    /tmp/shiftmate-storage/framework/sessions \
    /tmp/shiftmate-storage/framework/views \
    /tmp/shiftmate-storage/logs \
    && chmod -R 0775 bootstrap/cache /tmp/shiftmate-storage

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    LARAVEL_STORAGE_PATH=/tmp/shiftmate-storage

EXPOSE 80
CMD ["sh", "-c", "rm -f bootstrap/cache/config.php && exec frankenphp run --config /etc/frankenphp/Caddyfile"]
