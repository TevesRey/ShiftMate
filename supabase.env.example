# Copy these settings into your local .env or Render environment variables.
# Use the Session Pooler URI from Supabase for Render (not the API or anon key).
# URL-encode special characters in the database password before adding it to the URI.
DB_CONNECTION=pgsql
DB_SSLMODE=require
DATABASE_URL="postgresql://postgres.your-project-ref:your-database-password@your-session-pooler-host:5432/postgres?sslmode=require"
